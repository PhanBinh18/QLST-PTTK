@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #1E293B
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #1E293B
}

node "<<device>>\nClient Machine" as client {
  node "<<executionEnvironment>>\nWeb Browser" as browser {
  }
}

node "<<device>>\nWeb Application Server" as webserver {
  node "<<executionEnvironment>>\nApache Tomcat Server" as tomcat {
    package "view" {
      package "Member7" {
      }
      package "Customer7" {
      }
      package "WarehouseStaff7" {
      }
      package "SaleStaff7" {
      }
      package "Manager7" {
      }
    }
    package "DAO" {
    }
    package "model" {
    }

    view ..> DAO : <<use>>
    DAO ..> model : <<use>>
  }
}

node "<<device>>\nDatabase Server" as dbserver {
  node "<<executionEnvironment>>\nMySQL Server" as mysql {
    database "qlst_db" {
    }
  }
}

client -right- webserver : <<HTTP/HTTPS>>\nTCP/IP
webserver -right- dbserver : <<JDBC>>\nTCP/IP
@enduml
